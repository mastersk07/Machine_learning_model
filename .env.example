TENSORX_API_KEY=your-tensorx-api-key
TENSORX_BASE_URL=https://api.tensorx.ai/v1
TENSORX_MODEL=default

# Set to 0.0.0.0 to allow other devices on your local network (e.g. your
# phone) to open the web HUD too - only do this on a trusted network, this
# app has no login. Leave unset/127.0.0.1 to keep it to this machine only.
JARVIS_WEB_HOST=127.0.0.1

GOOGLE_CALENDAR_ENABLED=false
GMAIL_ENABLED=false

X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=
